[Unit]
Description=Portal backend (mango)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.mango
ExecStart=@libexecdir@/xdg-desktop-portal-mango
Restart=on-failure
RestartSec=5s
